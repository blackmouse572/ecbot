# Build dependencies
**/node_modules/
npm-debug.log
coverage/
dist/
swagger.json
.husky/
.github/
assets/
src/metadata.ts

# Local dev secrets — never bake into an image; production keys/secrets are
# injected at runtime (GCS-FUSE volume mount / Secret Manager), not COPYed in
apps/api/keys/*
!apps/api/keys/.gitignore

# Logs
logs/
*.log

# Environment (contains sensitive data)
.env*
# apps/app is Vite — env vars are baked into the bundle at build time
# (unlike api, which reads .env at runtime via env_file), so its .env
# must be present in the build context.
!apps/app/.env

# Versioning and metadata
.git
.gitignore
.dockerignore
.eslintignore

# Files not required for production
.editorconfig
dockerfile
docker-compose.yml
cspell.json
README.md
nodemon.json

# Turbo cache
.turbo/

# Test files
test/
tests/
**/*.test.*
**/*.spec.*

# Documentation
docs/
*.md
!README.md

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
**/.DS_Store
**/Thumbs.db

# CI/CD
.travis.yml
.circleci/

# Fly.io configs
fly*.toml