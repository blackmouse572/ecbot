{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "~/.config/opencode/node_modules/superpowers",
  ],
  "instructions": ["AGENT.md"],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "apps/api/dist/**",
      "apps/app/dist/**",
      "apps/web/.next/**"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "tools": {
    "websearch": true,
    "codesearch": true
  }
}
