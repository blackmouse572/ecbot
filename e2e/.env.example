# E2E Test Environment Variables
# Copy to .env and fill in values before running locally

# ── URLs ──────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:5173
API_URL=http://localhost:8080
AI_URL=http://localhost:8000

# ── Auth ──────────────────────────────────────────────────────────────────────
# Format: key:secret (e.g. <key>:<secret>)
# Must match an API key seeded in apps/api (seed: pnpm db:seed)
E2E_API_KEY=

# ── Test Helpers ──────────────────────────────────────────────────────────────
# Must match E2E_TEST_KEY in apps/api/.env (only active when E2E_TEST_HELPERS=true)
E2E_TEST_KEY=

# ── AI / Smoke tests only ─────────────────────────────────────────────────────
# Required only for @smoke tests (real LLM). DeepSeek key works (OpenAI-compatible).
# Leave empty for regression tests — they skip chat if no cassettes exist.
OPENAI_API_KEY=
