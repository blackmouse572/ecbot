{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "TURBO_DEFAULT"],
  "tasks": {
    "generate:keys": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^generate:keys"]
    },
    "generate:client": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^generate:client"]
    },
    "migration:create": {
      "cache": false,
      "persistent": false
    },
    "migration:up": {
      "cache": false,
      "persistent": false
    },
    "migrate:seed": {
      "cache": false,
      "persistent": false
    },
    "migration:down": {
      "cache": false,
      "persistent": false
    },
    "migration:list": {
      "cache": false,
      "persistent": false
    },
    "migration:check": {
      "cache": false,
      "persistent": false
    },
    "migration:pending": {
      "cache": false,
      "persistent": false
    },
    "migration:fresh": {
      "cache": false,
      "persistent": false
    },
    "schema:create": {
      "cache": false,
      "persistent": false
    },
    "schema:drop": {
      "cache": false,
      "persistent": false
    },
    "schema:update": {
      "cache": false,
      "persistent": false
    },
    "schema:fresh": {
      "cache": false,
      "persistent": false
    },
    "seeder:run": {
      "cache": false,
      "persistent": false
    },
    "seeder:create": {
      "cache": false,
      "persistent": false
    },
    "database:import": {
      "cache": false,
      "persistent": false
    },
    "cache:clear": {
      "cache": false,
      "persistent": false
    },
    "generate-entities": {
      "cache": false,
      "persistent": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "admin#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "VITE_API_KEY",
        "VITE_API_KEY_SECRET",
        "VITE_API_URL",
        "VITE_TURNSTILE_SITE_KEY"
      ]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"],
      "env": [
        "NEXT_PUBLIC_API_KEY",
        "NEXT_PUBLIC_API_KEY_SECRET",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
        "NEXT_PUBLIC_SITE_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^test:api", "^lint"]
    },
    "start:prod": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^start:prod"]
    }
  }
}
