# Read by docker-compose.yml. `pnpm setup:local` creates .env from this file
# and fills POSTGRES_PASSWORD. See docs/self-hosting.md.

# Password of the compose Postgres. Generated for a fresh install and written
# into apps/api/.env's DATABASE_URL too. Postgres only reads it when its volume
# is first created.
POSTGRES_PASSWORD=

# Public URL of this install, used by `docker compose --profile full`. The app
# and the API share it (the API is served under /api). With a domain, such as
# https://chat.example.com, Caddy gets a TLS certificate on first start; its
# DNS must point at this server and ports 80 and 443 must be open.
# Rebuild the app image after changing it: docker compose --profile full up -d --build
SITE_URL=http://localhost
