{
  "name": "eccho",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:app": "turbo run dev --filter api --filter app",
    "start:prod": "turbo run start:prod",
    "test:api": "turbo run test --filter api",
    "generate:client": "turbo run generate:client --filter api",
    "generate:keys": "turbo run generate:keys",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check:file-type-sync": "node scripts/check-knowledge-file-type-sync.mjs",
    "db:migrate:create": "turbo run migration:create --filter api",
    "db:migrate:up": "turbo run migration:up --filter api",
    "db:migrate:down": "turbo run migration:down --filter api",
    "db:migrate:list": "turbo run migration:list --filter api",
    "db:migrate:check": "turbo run migration:check --filter api",
    "db:migrate:pending": "turbo run migration:pending --filter api",
    "db:migrate:fresh": "turbo run migration:fresh --filter api",
    "db:schema:create": "turbo run schema:create --filter api",
    "db:schema:drop": "turbo run schema:drop --filter api",
    "db:schema:update": "turbo run schema:update --filter api",
    "db:schema:fresh": "turbo run schema:fresh --filter api",
    "db:seed": "turbo run migrate:seed --filter api",
    "db:seed:create": "turbo run seeder:create --filter api",
    "db:import": "turbo run database:import --filter api",
    "db:cache:clear": "turbo run cache:clear --filter api",
    "db:generate-entities": "turbo run generate-entities --filter api",
    "e2e": "pnpm --filter @repo/e2e test",
    "e2e:smoke": "pnpm --filter @repo/e2e test:smoke",
    "e2e:ui": "pnpm --filter @repo/e2e test:ui",
    "e2e:record:up": "docker-compose -f docker-compose.yml -f docker-compose.e2e.yml -f docker-compose.e2e.record.yml up -d --build --wait",
    "e2e:record:down": "docker-compose -f docker-compose.yml -f docker-compose.e2e.yml -f docker-compose.e2e.record.yml down -v"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.3",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "tar": "^7.5.19",
      "handlebars": "^4.7.9",
      "axios@<1": "^0.34.0",
      "nanoid@>=4": "^5.1.16",
      "js-yaml@4": "^4.3.2",
      "js-yaml@3": "^3.15.2",
      "postcss": "^8.5.18",
      "sharp": "^0.35.4",
      "multer": "^2.3.0",
      "@nestjs/terminus>mongoose": "-",
      "@nestjs/terminus>@nestjs/mongoose": "-",
      "gaxios>uuid": "^11.1.1",
      "ajv@>=8.0.0 <8.18.0": "^8.18.0"
    }
  },
  "dependencies": {
    "@turbo/gen": "^2.11.3",
    "slugify": "^1.6.9"
  }
}
