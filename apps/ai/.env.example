# Generals
# ENV: development | staging | production
ENV=development
# Recommended per env: development=DEBUG, staging=INFO, production=INFO
LOG_LEVEL=DEBUG

# LLMs
# All chat/guardrail/classifier/image/embedding calls route through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FIRECRAWL_API_KEY=
# Bounds a single chat-model call so a hung upstream can't hang the agent loop.
CHAT_MODEL_TIMEOUT_SECONDS=60

# Postgres
POSTGRES_URL=postgresql+asyncpg://postgres:password@localhost:5432/eccho
# Optional. Leave empty to store RAG documents/vectors in POSTGRES_URL.
RAG_POSTGRES_URL=

# Ecbot api callback (for tool execution)
API_BASE_URL=http://localhost:8080
AI_SERVICE_API_KEY=
AI_SERVICE_API_SECRET=

# Shared secret required on every inbound apps/api -> apps/ai call (X-Internal-Token
# header). Must match apps/api's own API_INTERNAL_TOKEN. Empty fails closed (503).
# Dev placeholder only — use a strong random value in any deployed environment.
API_INTERNAL_TOKEN=dev-internal-token-change-me

# Langsmith tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=eccho

# Embedding (used by the chunking job) — full OpenRouter model id
EMBEDDING_MODEL=google/gemini-embedding-001
EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=512
CHUNK_OVERLAP=50
EMBEDDING_BATCH_SIZE=20

# MinIO / S3 (used by the jobs service to download FILE attachments)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false

# RAG ingest/retrieval
RAG_LOCAL_STORAGE_DIR=storage/rag_uploads
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_EMBEDDING_MODEL=google/gemini-embedding-001
RAG_EMBEDDING_DIMENSION=768
RAG_RETRIEVAL_ENABLED=true
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_CANDIDATE_LIMIT=24
RAG_RETRIEVAL_CONTEXT_MAX_CHARS=6000
RAG_RETRIEVAL_MIN_SCORE=0.05
RAG_RERANK_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANK_BATCH_SIZE=16

# Auxiliary OpenRouter models (full provider/model ids)
GUARDRAIL_MODEL=google/gemini-2.5-flash
CLASSIFIER_MODEL=google/gemini-2.5-flash
IMAGE_MODEL=google/gemini-2.5-flash-image
# Describes images users send (must accept image input). Its tokens are
# added to the turn's usage. Images beyond the count/size caps are skipped.
VISION_MODEL=google/gemini-2.5-flash
VISION_MAX_IMAGES=10
VISION_MAX_CATALOG_IMAGES=6
VISION_MAX_IMAGE_BYTES=5242880
CUSTOMER_CLASSIFIER_TEMPERATURE=0.1

# Caching. GUARDRAIL_CACHE_MAXSIZE=0 disables the guardrail verdict cache;
# CHATBOT_CACHE_TTL_SECONDS=0 disables the chatbot-config cache (apps/api
# invalidates it explicitly via DELETE /api/chat/chatbot-cache/{id}).
GUARDRAIL_CACHE_MAXSIZE=1000
EMBEDDING_CACHE_MAXSIZE=512
EMBEDDING_CACHE_TTL_SECONDS=300
CHATBOT_CACHE_TTL_SECONDS=60

# E2E cassette mode (live = disabled, new_episodes = record, none = replay only)
AI_CASSETTE_MODE=live
VCR_CASSETTE_DIR=
