# Local development values (used by `vite` / `vite build --mode development`)
VITE_API_KEY=""
VITE_API_KEY_SECRET=""
VITE_API_URL="http://localhost:8080"

# Origin of the admin portal; impersonation returns here on exit. Unset keeps
# the exit link relative to this app.
VITE_ADMIN_URL="http://localhost:5174"

# Origin of the docs site; the sign-up form and the website widget link to its
# Terms of Service and Privacy Policy pages. Unset uses https://ecbot.dev.
# Run `pnpm dev:docs` and set "http://localhost:5175" to test against local docs.
VITE_DOCS_URL="https://ecbot.dev"

# Cloudflare Turnstile site key; pair with TURNSTILE_SECRET_KEY on apps/api.
# Unset renders no widget. Below is Cloudflare's always-pass TEST site key.
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

VITE_FACEBOOK_APP_ID="1234567890123456"
VITE_FACEBOOK_REDIRECT_URI="http://localhost:5173/auth/facebook/callback"
# WhatsApp Embedded Signup configuration ID (Meta app → WhatsApp use case →
# Embedded Signup Builder → create configuration). Opened as a facebook.com popup
# with VITE_FACEBOOK_APP_ID and VITE_FACEBOOK_REDIRECT_URI above, which must be
# HTTPS and listed in Meta's Valid OAuth Redirect URIs.
VITE_WHATSAPP_CONFIG_ID=""
VITE_ZALO_APP_ID="1234567890123456789"
VITE_ZALO_REDIRECT_URI="http://localhost:5173/auth/zalo/callback"

# ------------------------------------------------------------------
# Deploy-time values are baked into the bundle at build time by Vite.
# Create gitignored per-environment files (same keys as above):
#
#   .env.staging      -> `vite build --mode staging`  (pnpm deploy:staging)
#   .env.production   -> `vite build --mode production` (pnpm deploy)
#
# The wrangler.json `env.*.vars` blocks mirror these values as Worker
# bindings (vars are NOT inherited by wrangler environments, so each
# env block must list the full set).
# ------------------------------------------------------------------
