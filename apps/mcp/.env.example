# Local config for `wrangler dev` (loaded via --env-file, see package.json).

# apps/api base URL. Every tool call goes there with the caller's client
# credential; this worker holds no secrets of its own.
SERVER_URL="http://localhost:8080"

# "enterprise" only on the Ecbot Cloud worker (the overlay's wrangler.json
# sets it): lists the tools for overlay-only routes, such as get_plan_usage.
# ECCHO_EDITION="enterprise"
