# Local dev secrets for `wrangler dev` (loaded via --env-file, see package.json).
# SERVER_URL is NOT a secret — it's already committed in wrangler.json's `vars`
# block and doesn't need to be repeated here unless you want to override it locally.

# Shared secret with apps/api — must match apps/api's POC_EDGE_INTERNAL_SECRET.
# Verified against the `x-internal-secret` header on the internal debounce route.
INTERNAL_SECRET=""

# x-api-key sent to apps/api (SERVER_URL) on outbound requests.
SERVER_API_KEY=""

# Verify token for Facebook/Messenger's GET webhook challenge (Meta's
# hub.verify_token). Must match apps/api's FACEBOOK_WEBHOOK_SECRET exactly —
# rotate both together.
FACEBOOK_WEBHOOK_SECRET=""
