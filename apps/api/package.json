{
    "name": "api",
    "version": "7.4.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/blackmouse572/ecbot.git",
        "directory": "apps/api"
    },
    "author": {
        "name": "Ecbot"
    },
    "private": true,
    "license": "AGPL-3.0-only",
    "scripts": {
        "clean": "rimraf dist && rimraf node_modules && yarn cache clean",
        "build": "nest build",
        "format": "prettier --write '{src,test}/**/*.{ts,json,yml,yaml}' && prettier --write '*.{ts,json,yml,yaml,mjs}'",
        "start": "nest start",
        "dev": "nest start -w",
        "start:prod": "node dist/main",
        "lint": "eslint",
        "check-types": "tsc --noEmit",
        "lint:staged": "lint-staged",
        "lint:fix": "eslint --fix",
        "test": "TZ=UTC jest --config test/jest.json --passWithNoTests --forceExit",
        "test:e2e": "TZ=UTC jest --config test/jest-e2e.json --runInBand --forceExit",
        "deadcode": "ts-prune --project tsconfig.json --unusedInModule --skip *.json",
        "spell": "cspell lint --config cspell.json '{src,test}/**/*.ts' --color --gitignore --no-must-find-files --no-summary --no-progress || true",
        "package:upgrade": "npx npm-check-updates -u",
        "package:check": "npx npm-check-updates -i",
        "generate:keys": "npx ts-node scripts/generate-keys.ts",
        "generate:client": "openapi-ts",
        "migrate:fresh": "yarn migrate:remove && yarn migrate:seed",
        "migrate:seed": "nestjs-command seed:country && nestjs-command seed:apikey && nestjs-command seed:role && nestjs-command seed:user",
        "migrate:seed:e2e": "nestjs-command seed:country && nestjs-command seed:apikey && nestjs-command seed:role && nestjs-command seed:user",
        "migrate:remove": "nestjs-command remove:user && nestjs-command remove:country && nestjs-command remove:apikey && nestjs-command remove:role",
        "migrate:template": "nestjs-command migrate:template",
        "migrate:account-tokens": "nestjs-command account:reencrypt-tokens",
        "rollback:template": "nestjs-command rollback:template",
        "mikro-orm": "npx mikro-orm",
        "migration:create": "npx mikro-orm migration:create",
        "migration:up": "npx mikro-orm migration:up",
        "migration:down": "npx mikro-orm migration:down",
        "migration:list": "npx mikro-orm migration:list",
        "migration:check": "npx mikro-orm migration:check",
        "migration:pending": "npx mikro-orm migration:pending",
        "migration:fresh": "npx mikro-orm migration:fresh",
        "schema:create": "npx mikro-orm schema:create",
        "schema:drop": "npx mikro-orm schema:drop",
        "schema:update": "npx mikro-orm schema:update",
        "schema:fresh": "npx mikro-orm schema:fresh",
        "seeder:run": "npx mikro-orm seeder:run",
        "seeder:create": "npx mikro-orm seeder:create",
        "database:import": "npx mikro-orm database:import",
        "cache:clear": "npx mikro-orm cache:clear",
        "generate-entities": "npx mikro-orm generate-entities"
    },
    "dependencies": {
        "@aws-sdk/client-pinpoint": "^3.1117.0",
        "@aws-sdk/client-s3": "^3.1117.0",
        "@aws-sdk/client-ses": "^3.1117.0",
        "@aws-sdk/s3-request-presigner": "^3.1117.0",
        "@casl/ability": "^6.8.1",
        "@composio/core": "^0.10.0",
        "@google-cloud/tasks": "^6.3.0",
        "@grpc/grpc-js": "^1.14.4",
        "@keyv/redis": "^4.6.0",
        "@mikro-orm/core": "^6.6.16",
        "@mikro-orm/nestjs": "^6.1.2",
        "@mikro-orm/postgresql": "^6.6.16",
        "@modelcontextprotocol/sdk": "~1.29.0",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/bullmq": "^11.0.5",
        "@nestjs/cache-manager": "^3.1.3",
        "@nestjs/common": "^11.2.1",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.2.1",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.2.1",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.4.7",
        "@nestjs/terminus": "^11.1.1",
        "@nestjs/throttler": "^6.5.0",
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^1.4.0",
        "@scalar/nestjs-api-reference": "^0.5.14",
        "@sentry/nestjs": "^10.71.0",
        "ajv": "^8.20.0",
        "axios": "^1.19.0",
        "bcryptjs": "^3.0.3",
        "body-parser": "^2.3.0",
        "bullmq": "^6.3.8",
        "bytes": "^3.1.2",
        "cache-manager": "^6.4.3",
        "case": "^1.6.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.4",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "crypto-js": "^4.2.0",
        "dotenv": "^16.6.1",
        "form-data": "^4.0.6",
        "google-auth-library": "^9.15.1",
        "helmet": "^8.3.0",
        "ioredis": "5.11.1",
        "jsonwebtoken": "^9.0.3",
        "jwks-rsa": "^3.2.2",
        "lodash": "^4.18.1",
        "luxon": "^3.7.2",
        "ms": "^2.1.3",
        "multer": "^2.3.0",
        "nestjs-axios-retry": "^1.0.7",
        "nestjs-cls": "^6.2.1",
        "nestjs-command": "^3.1.5",
        "nestjs-i18n": "^10.8.5",
        "nestjs-pino": "^4.6.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pino-http": "^10.5.0",
        "pino-pretty": "^13.1.3",
        "react": "19.1.0",
        "reflect-metadata": "^0.2.2",
        "resend": "^4.8.0",
        "response-time": "^2.3.4",
        "rotating-file-stream": "^3.2.10",
        "rxjs": "^7.8.2",
        "slugify": "^1.6.9",
        "stripe": "^22.6.2",
        "undici": "^7.29.0",
        "verify-apple-id-token": "^3.1.2",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
        "yargs": "^17.7.3"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@faker-js/faker": "^10.5.0",
        "@hey-api/openapi-ts": "^0.99.0",
        "@mikro-orm/cli": "^6.6.16",
        "@mikro-orm/migrations": "^6.6.16",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.2.1",
        "@smithy/types": "^4.17.2",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.16.1",
        "@swc/jest": "^0.2.39",
        "@types/bytes": "^3.1.6",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/crypto-js": "^4.2.2",
        "@types/express": "^5.0.6",
        "@types/jest": "^29.5.14",
        "@types/localtunnel": "^2.0.4",
        "@types/lodash": "^4.17.25",
        "@types/luxon": "^3.7.5",
        "@types/ms": "^2.1.0",
        "@types/multer": "^1.4.13",
        "@types/node": "^22.20.1",
        "@types/passport-jwt": "^4.0.1",
        "@types/react": "19.1.0",
        "@types/react-dom": "19.1.1",
        "@types/response-time": "^2.3.9",
        "@types/supertest": "^6.0.3",
        "cspell": "^8.19.4",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "lint-staged": "^15.5.2",
        "localtunnel": "^2.0.2",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.3",
        "stop-only": "^3.4.4",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "ts-prune": "^0.10.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.68.0"
    },
    "lint-staged": {
        "**/*.ts": [
            "eslint",
            "stop-only --file"
        ],
        "*.{json,yaml}": [
            "prettier --write"
        ]
    }
}
