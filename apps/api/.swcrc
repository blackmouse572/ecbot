{
    "$schema": "https://swc.rs/schema.json",
    "sourceMaps": true,
    "module": {
        "type": "commonjs"
    },
    "jsc": {
        "baseUrl": "./",
        "paths": {
            "src/*": ["src/*"]
        },
        "target": "esnext",
        "parser": {
            "syntax": "typescript",
            "tsx": true,
            "decorators": true,
            "dynamicImport": true
        },
        "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true,
            "react": {
                "runtime": "automatic"
            }
        }
    },
    "minify": false,
    "exclude": ["node_modules", "dist", "coverage", "src/metadata.ts", "logs"]
}
