APP_NAME=Ecbot
APP_ENV=local
APP_LANGUAGE=en
APP_TIMEZONE=Asia/Ho_Chi_Minh

# HOME_URL = the FRONTEND origin (the app users open). Used for email links, etc.
HOME_URL=https://example.id
HOME_NAME=Ecbot

# API_BACKEND_URL = the public origin of THIS backend API (no trailing slash),
# reachable from the internet. Used to build absolute provider webhook URLs
# (e.g. Telegram setWebhook). This is the API host — NOT the frontend HOME_URL
# above, and NOT the AI service AI_BACKEND_URL. e.g. https://eccho.onrender.com
API_BACKEND_URL=https://example.id

HTTP_HOST=localhost
HTTP_PORT=8080

DEBUG_ENABLE=true
DEBUG_LEVEL=debug
DEBUG_INTO_FILE=false
DEBUG_PRETTIER=true

# Comma-separated origins. Not `*`: a wildcard turns credentialed requests
# off, and the apps send credentials. Add each local frontend you run.
MIDDLEWARE_CORS_ORIGIN=http://localhost:5173

URL_VERSIONING_ENABLE=true
URL_VERSION=1

DATABASE_URL=postgresql://postgres:password@localhost:5432/eccho
DATABASE_DEBUG=true
DATABASE_SSL=false

AUTH_JWT_ISSUER=https://example.id
AUTH_JWT_AUDIENCE=Ecbot

# Served by the `jwks-server` container from apps/api/keys/ after `pnpm generate:keys`.
# Inside docker-compose use http://jwks-server:80/.well-known/jwks.json
AUTH_JWT_JWKS_URI=http://localhost:3011/.well-known/jwks.json

AUTH_JWT_ACCESS_TOKEN_KID=
AUTH_JWT_ACCESS_TOKEN_PRIVATE_KEY_PATH=keys/access-token.pem
AUTH_JWT_ACCESS_TOKEN_PUBLIC_KEY_PATH=keys/access-token.pub
AUTH_JWT_ACCESS_TOKEN_EXPIRED=1h

AUTH_JWT_REFRESH_TOKEN_KID=
AUTH_JWT_REFRESH_TOKEN_PRIVATE_KEY_PATH=keys/refresh-token.pem
AUTH_JWT_REFRESH_TOKEN_PUBLIC_KEY_PATH=keys/refresh-token.pub
AUTH_JWT_REFRESH_TOKEN_EXPIRED=7d

AUTH_SOCIAL_GOOGLE_CLIENT_ID=
AUTH_SOCIAL_GOOGLE_CLIENT_SECRET=

AUTH_SOCIAL_APPLE_CLIENT_ID=
AUTH_SOCIAL_APPLE_SIGN_IN_CLIENT_ID=

# Set AWS_S3_*_ENDPOINT to use an S3-compatible provider (e.g. Cloudflare R2);
# leave empty for AWS S3. For R2: endpoint=https://<account>.r2.cloudflarestorage.com, region=auto
AWS_S3_PUBLIC_CREDENTIAL_KEY=
AWS_S3_PUBLIC_CREDENTIAL_SECRET=
AWS_S3_PUBLIC_REGION=ap-southeast-3
AWS_S3_PUBLIC_BUCKET=
AWS_S3_PUBLIC_ENDPOINT=
AWS_S3_PUBLIC_CDN=
AWS_S3_PRIVATE_CREDENTIAL_KEY=
AWS_S3_PRIVATE_CREDENTIAL_SECRET=
AWS_S3_PRIVATE_REGION=ap-southeast-3
AWS_S3_PRIVATE_BUCKET=
AWS_S3_PRIVATE_ENDPOINT=

AWS_SES_CREDENTIAL_KEY=
AWS_SES_CREDENTIAL_SECRET=
AWS_SES_REGION=ap-southeast-3

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

SENTRY_DSN=

# Leave empty to boot without email; sending fails until it is set.
RESEND_API_KEY=
EMAIL_PROVIDER=resend
# Optional — defaults to the verified Resend domain (onboarding@noreply.ecbot.dev)
EMAIL_FROM=

WORK_SPACE_INVITATION_TOKEN_SECRET_KEY=
WORK_SPACE_INVITATION_TOKEN_EXPIRED=

# ── Meta (Messenger + WhatsApp Business) ─────────────────────────────────────
# WhatsApp Cloud API shares this Meta app: FACEBOOK_APP_SECRET verifies its
# x-hub-signature-256, FACEBOOK_WEBHOOK_SECRET is the hub.verify_token for
# /api/v1/public/webhooks/whatsapp. Numbers are linked per workspace in the UI
# (phone number ID + System User token), so WhatsApp needs no vars of its own.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v23.0
FACEBOOK_WEBHOOK_SECRET=
FACEBOOK_REDIRECT_URI=https://app.example.com/account-callback
FACEBOOK_CALLBACK_URL=http://example.com/api/v1
FACEBOOK_PAGE_ACCESS_TOKEN=

# ── OAuth token encryption (required for all platforms) ──────────────────────
# pnpm --filter api run generate:keys generate keys  fills this in when empty
# (or generate manually: openssl rand -hex 16 — 32 hex chars = 32-char key for AES-256-GCM)
# IV is generated randomly per encryption call — no IV env var needed.
OAUTH_TOKEN_ENCRYPT_KEY=
# Optional: override the default key ID used for new encryptions (default: v1)
# OAUTH_TOKEN_ENCRYPT_DEFAULT_KEY_ID=v1

# ── Instagram ─────────────────────────────────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://app.example.com/account-callback

# ── Zalo ──────────────────────────────────────────────────────────────────────
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=https://app.example.com/account-callback

# ── TikTok Shop ───────────────────────────────────────────────────────────────
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=https://app.example.com/account-callback

# ── Shopee ────────────────────────────────────────────────────────────────────
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=https://app.example.com/account-callback

# ── Telegram ──────────────────────────────────────────────────────────────────
# Optional: sent back by Telegram as X-Telegram-Bot-Api-Secret-Token on every webhook call.
# Requirements: 1-256 chars, only A-Z a-z 0-9 _ - allowed.
# Generate: openssl rand -hex 32 | tr -dc 'A-Za-z0-9_-' | head -c 64
TELEGRAM_WEBHOOK_SECRET_TOKEN=your-64-char-secret-token-here_replace-this-value-ABCDEFGHIJKLMN
# TELEGRAM_API_URL=https://api.telegram.org   # override for local mock servers

AI_BACKEND_URL=http://localhost:8000

LOCAL_TUNNEL_ENABLE=false
LOCAL_TUNNEL_SUBDOMAIN=eccho-local-tunnel

# Composio (eccho-owned, used by Tool Registry marketplace)
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_REDIRECT_URI=

# Service-to-service: shared with apps/ai (set identical values on both apps)
AI_SERVICE_API_KEY=
AI_SERVICE_API_SECRET=

# Seed-time pin for the DEFAULT API key, as key:secret. The frontends send the
# same pair as VITE_API_KEY / VITE_API_KEY_SECRET. Empty = the seed generates a
# random pair and prints it once. `pnpm setup:local` fills all three for you.
E2E_SEED_DEFAULT_API_KEY=

# ── BullMQ worker concurrency (optional, reduce in memory-constrained envs) ───
# WORKER_CONCURRENCY_INBOUND=8
# WORKER_CONCURRENCY_INGEST=3
# WORKER_CONCURRENCY_TAG_CLASSIFIER=2

# E2E testing only — NEVER set in production or staging
E2E_TEST_HELPERS=false
# With E2E_TEST_HELPERS=true this key enables endpoints that bypass authentication —
# for automated tests only. The module refuses to load when APP_ENV=production
# (the real deployment switch) or NODE_ENV=production.
E2E_TEST_KEY=

# ── Cloud Tasks configuration ─────────────────────────────────────────────────
CLOUD_TASKS_PROJECT_ID=eccho-dev
CLOUD_TASKS_LOCATION=asia-southeast1
CLOUD_TASKS_SYSTEM_API_KEY=

# Enable it when you need emulator for local dev env
# CLOUD_TASKS_EMULATOR_HOST=localhost:8123

# ── Turnstile ─────────────────────────────────────────────────────────────────
# Cloudflare Turnstile secret key, verifying login, sign-up and waitlist.
# Unset disables verification entirely — the value below is Cloudflare's
# always-pass TEST secret (use 2x00...AA to always block).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Chatbot preview share links (issue #80) ───────────────────────────────────
# HS256 secret for the signed, time-limited public preview link. Must be set for
# share-link creation to work; the public preview endpoints reject every token
# when unset. Independent of the ES512 auth keypair.
CHATBOT_PREVIEW_SHARE_TOKEN_SECRET_KEY=

# ── Billing & token metering (issues #78 / #79) ───────────────────────────────
# Payment providers a plan edit is mirrored into, comma-separated
# (STRIPE, SEPAY, ZALOPAY). Empty — the default — keeps plans local, which is
# what you want for dev and for self-hosting without billing.
BILLING_SYNC_PROVIDERS=

# Required only when STRIPE is listed above; without it the Stripe adapter
# reports itself unconfigured and is skipped rather than failing plan writes.
STRIPE_SECRET_KEY=

# Quota seeded onto the bootstrap `free` plan, in tokens.
BILLING_FREE_PLAN_TOKEN_QUOTA=1000000

# Default low-balance warning point, as a percent of the period quota remaining.
# A workspace can override it from the usage page.
BILLING_LOW_BALANCE_THRESHOLD=20
